# Browser WebSocket + CLI install snippets (absolute Gateway).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080

# Server-side BFF → Gateway (defaults to NEXT_PUBLIC_API_BASE).
# AOP_GATEWAY_URL=http://127.0.0.1:8080

# Optional server-side API key when no user session cookie (never expose as NEXT_PUBLIC_*).
# AOP_API_KEY=aop_sk_dev_local_0000000000000001

# When true, Next middleware redirects unauthenticated page loads to /login.
# AUTH_REQUIRED=false
# NEXT_PUBLIC_AUTH_REQUIRED=false

# Set COOKIE_SECURE=true behind HTTPS.
# COOKIE_SECURE=false
